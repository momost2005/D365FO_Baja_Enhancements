			<Method>
				<Name>Find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds a periodic quality group by periodic code.
    /// </summary>
    /// <param name="_periodicCode">Periodic code to search for.</param>
    /// <returns>Record if found; otherwise, null.</returns>
    public static TxBaja_PeriodicQualityGroup Find(str _periodicCode, boolean _forUpdate=false)
    {
        TxBaja_PeriodicQualityGroup rec;

        select firstonly rec
            where rec.PeriodicCode == _periodicCode;

        if(_forUpdate)
        {
            rec.selectForUpdate(true);
        }

        return rec;
    }

]]></Source>
			</Method>
			<Method>
				<Name>ExistsByCode</Name>
				<Source><![CDATA[
    /// <summary>
    /// This method checks if a periodic quality group exists by its periodic code.
    /// </summary>
    /// <param name = "_periodicCode"></param>
    /// <returns></returns>
    public static boolean ExistsByCode(str _periodicCode)
    {
        TxBaja_PeriodicQualityGroup rec;

        select firstonly rec
            where rec.PeriodicCode == _periodicCode;
        
        return rec.RecId != 0;
    }

]]></Source>
